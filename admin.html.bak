<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin Dashboard — Travel and Challenge</title>
<meta name="robots" content="noindex,nofollow">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Thai:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/desktop.css">
<link rel="stylesheet" href="/css/mobile.css">
<link rel="stylesheet" href="/css/animations.css">
<link rel="stylesheet" href="/css/pages/admin.css">
</head>
<body data-protected="true">
<nav id="site-nav" aria-label="Main"></nav>
<main class="section">
  <div class="container wide">

    <div class="admin-header">
      <h1>Admin Dashboard</h1>
      <span class="meta">All content operations use RLS — is_admin() — for authorization.</span>
    </div>

    <!-- Stats -->
    <div class="stats-grid" aria-label="Key metrics">
      <div class="stat-card">
        <span class="stat-value" id="stat-places">—</span>
        <span class="stat-label">Published destinations</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-quests">—</span>
        <span class="stat-label">Published quests</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-campaigns">—</span>
        <span class="stat-label">Active campaigns</span>
      </div>
      <div class="stat-card">
        <span class="stat-value" id="stat-completions">—</span>
        <span class="stat-label">Quest completions</span>
      </div>
    </div>

    <!-- Tab navigation -->
    <div class="admin-tabs" role="tablist" aria-label="Admin sections">
      <button class="tab-btn" role="tab" aria-selected="true"  data-tab="places"    id="tab-places">Destinations</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-tab="quests"    id="tab-quests">Quests</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-tab="campaigns" id="tab-campaigns">Campaigns</button>
      <button class="tab-btn" role="tab" aria-selected="false" data-tab="audit"     id="tab-audit">Audit log</button>
    </div>

    <!-- ── Destinations panel ── -->
    <section id="panel-places" class="tab-panel" role="tabpanel" aria-labelledby="tab-places" aria-hidden="false">
      <div class="toolbar">
        <div class="form-field">
          <label for="place-search" class="sr-only">Search destinations</label>
          <input id="place-search" type="search" placeholder="Search destinations…" maxlength="80">
        </div>
        <button class="btn" id="btn-new-place" type="button">+ New destination</button>
      </div>
      <div class="table-wrap">
        <table class="table" aria-label="Destinations">
          <thead>
            <tr>
              <th>Name</th><th>Category</th><th>Province</th><th>Status</th><th>Updated</th><th>Actions</th>
            </tr>
          </thead>
          <tbody id="places-tbody"><tr><td colspan="6">Loading…</td></tr></tbody>
        </table>
      </div>
      <div id="places-pagination" class="pagination"></div>

      <div class="section soft" style="margin-top:2rem;padding:1rem 1.5rem;border-radius:var(--radius-medium)">
        <h3 style="font-size:1rem;margin-bottom:.5rem">Publishing checklist</h3>
        <ol class="meta" style="padding-left:1.5rem;margin:0">
          <li>Verify coordinates are correct on the map.</li>
          <li>Check that description is accurate and not copied from unverified sources.</li>
          <li>Add visitor information, opening hours, and entry fee only if verified.</li>
          <li>Mark the destination as <strong>Verified</strong>.</li>
          <li>Set status to <strong>Published</strong>.</li>
          <li>Confirm it appears on the Explore map and destination page.</li>
        </ol>
      </div>
    </section>

    <!-- ── Quests panel ── -->
    <section id="panel-quests" class="tab-panel" role="tabpanel" aria-labelledby="tab-quests" aria-hidden="true">
      <div class="toolbar">
        <div class="form-field">
          <label for="quest-search" class="sr-only">Search quests</label>
          <input id="quest-search" type="search" placeholder="Search quests…" maxlength="80">
        </div>
        <button class="btn" id="btn-new-quest" type="button">+ New quest</button>
      </div>
      <div class="table-wrap">
        <table class="table" aria-label="Quests">
          <thead>
            <tr><th>Title</th><th>Type</th><th>Difficulty</th><th>Status</th><th>Reward</th><th>Actions</th></tr>
          </thead>
          <tbody id="quests-tbody"><tr><td colspan="6">Loading…</td></tr></tbody>
        </table>
      </div>
      <div id="quests-pagination" class="pagination"></div>

      <div class="section soft" style="margin-top:2rem;padding:1rem 1.5rem;border-radius:var(--radius-medium)">
        <h3 style="font-size:1rem;margin-bottom:.5rem">Quest security notes</h3>
        <ul class="meta" style="padding-left:1.5rem;margin:0">
          <li>Reward tokens are granted by a security-definer database function, not by the browser.</li>
          <li>The server evaluates all answers; clients never control the reward amount.</li>
          <li>Rate limiting is enforced: 5 failed attempts per quest per 10 minutes.</li>
          <li>Check-in codes are stored in <code>quest_secrets</code> which has no public read policy.</li>
        </ul>
      </div>
    </section>

    <!-- ── Campaigns panel ── -->
    <section id="panel-campaigns" class="tab-panel" role="tabpanel" aria-labelledby="tab-campaigns" aria-hidden="true">
      <div class="toolbar">
        <button class="btn" id="btn-new-camp" type="button">+ New campaign</button>
      </div>
      <div class="table-wrap">
        <table class="table" aria-label="Campaigns">
          <thead>
            <tr><th>Title</th><th>Status</th><th>Starts</th><th>Ends</th><th>Actions</th></tr>
          </thead>
          <tbody id="camps-tbody"><tr><td colspan="5">Loading…</td></tr></tbody>
        </table>
      </div>
      <div id="camps-pagination" class="pagination"></div>
    </section>

    <!-- ── Audit log panel ── -->
    <section id="panel-audit" class="tab-panel" role="tabpanel" aria-labelledby="tab-audit" aria-hidden="true">
      <h2 style="font-size:1.25rem;margin-bottom:1rem">Recent administrative actions</h2>
      <div id="audit-log">Loading…</div>
    </section>

  </div><!-- /.container -->
</main>
<footer id="site-footer"></footer>
<script type="module" src="/js/app.js"></script>
<script type="module" src="/js/admin.js"></script>
</body>
</html>
